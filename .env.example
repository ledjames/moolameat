# Copy to .env. Never commit .env. Leave every secret empty in git.

# Shopify app credentials from the Dev Dashboard. Filled by `shopify app dev` / config link.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_products,read_inventory,read_locations
SHOPIFY_APP_URL=
SHOP_CUSTOM_DOMAIN=moolameat.com

# Confirmed business codes. Override only if SF issues a correction.
SF_COMPANY_CODE=8526949142
SF_SYS_SOURCE=8526949142
SF_MONTHLY_CARD=8526949142
SF_WAREHOUSE_CODE=852DCTZ
SF_INCLUDE_WAREHOUSE_ON_QUERY=true

# Issued credential values. Empty on purpose. Do not paste real values into git.
SF_ISSUED_ACCESS_CODE=
SF_ISSUED_PASS_CODE=
SF_ISSUED_MD5_CHECKWORD=

# Likely but unconfirmed mapping onto the spec fields. Allowed: access_code, pass_code, md5_checkword.
SF_MAP_SPEC_ACCESS_CODE=access_code
SF_MAP_SPEC_CHECK_WORD=pass_code
SF_MAP_MD5_SPECIAL_STRING=md5_checkword

# sit uses the documented SIT URL. production stays unusable until SF_PRODUCTION_REQUEST_URL is a confirmed full URL.
SF_ENVIRONMENT=sit
SF_SIT_REQUEST_URL=https://portal-gateway.sit.sf-express.com:55443/scc-portal-api-service/omsPortalService/sendRequest
# Unconfirmed. Do not invent a path or port. Host only: https://portal-gateway.sf-express.com
SF_PRODUCTION_REQUEST_URL=
# Optional full override. Leave empty.
SF_REQUEST_URL=

# Defaults follow the spec's documented request shape. SF has not confirmed them.
SF_PAYLOAD_FORMAT=xml
SF_CONTENT_TYPE=application/x-www-form-urlencoded
SF_SYS_SOURCE_PLACEMENT=header
SF_SERVICE_CODE_PLACEMENT=header
SF_LANG=zh-CN

# Must be the string true before any HTTP request from this app to SF is allowed.
# Inbound 3.15 pushes do not use this flag.
SF_LIVE_CALLS_ENABLED=false

# order_name matches ErpOrder to the Shopify order name. numeric_id matches the numeric order id.
SHOPIFY_ORDER_MATCH=order_name
SHOPIFY_NOTIFY_CUSTOMER=false
# Must be the string true before fulfillmentTrackingInfoUpdate runs. fulfillmentCreate is never called.
SHOPIFY_TRACKING_WRITES_ENABLED=false
